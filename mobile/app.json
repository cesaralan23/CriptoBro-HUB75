{
  "expo": {
    "name": "CriptoBro",
    "slug": "criptobro-local",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/studio-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/studio-foreground.png",
        "backgroundColor": "#0C0D14"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cesaralan23.criptobro",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/studio-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video"
    ],
    "scheme": "criptobro",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2680f485-0404-4a02-b013-e1274dc2e52f"
      }
    },
    "owner": "cesaracosta"
  }
}
